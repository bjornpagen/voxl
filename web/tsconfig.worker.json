{
	// The decode/socket worker, and the checks of its header reader and its record of
	// the screen (run by node, which wants the .ts extension and reads the fixture as JSON).
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022", "WebWorker"],
		"allowImportingTsExtensions": true
	},
	"include": [
		"src/worker.ts",
		"src/protocol.ts",
		"src/wire.json",
		"src/video-header.test.ts",
		"src/frames.test.ts"
	]
}
